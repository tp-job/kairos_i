# คัดลอกไฟล์นี้เป็น .env แล้วใส่ค่า API key ของตัวเอง
# .env จะไม่ถูก commit เข้า git (ดู .gitignore) แต่ต้องมีไฟล์นี้อยู่จริง
# ตอน build เพราะถูกประกาศเป็น asset ใน pubspec.yaml

# https://openrouter.ai/keys — โมเดลฟรีใช้ Context-Aware Orchestrator
OPENROUTER_API_KEY=

# https://home.openweathermap.org/api_keys
OPENWEATHER_API_KEY=

# https://app.clickup.com/settings/apps — Personal Token
CLICKUP_API_TOKEN=
# List ID ที่จะดึง/สร้าง task (เปิด List ใน ClickUp แล้วดู ID ใน URL)
CLICKUP_LIST_ID=

# https://gnews.io/ — free tier
GNEWS_API_KEY=

# https://www.alphavantage.co/support/#api-key — free tier
ALPHAVANTAGE_API_KEY=
